# ==============================================================================
# CVMama AI Configuration (Cloudflare Workers AI & Cloudflare AI Gateway)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Selection & Fallback Behavior
# ------------------------------------------------------------------------------
# Default provider tried first: "workers-ai" or "gateway"
DEFAULT_AI_PROVIDER="workers-ai"

# If true, automatically fails over to the other provider on errors/rate-limits
AI_FAILOVER_ENABLED="true"

# ------------------------------------------------------------------------------
# 2. Cloudflare Workers AI (Local Edge GPU)
# ------------------------------------------------------------------------------
WORKERS_AI_CHAT_MODEL="@cf/openai/gpt-oss-20b"
WORKERS_AI_PARSER_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# ------------------------------------------------------------------------------
# 3. Cloudflare AI Gateway (External Providers: Gemini, OpenAI, Anthropic, etc.)
# ------------------------------------------------------------------------------
# Cloudflare account and gateway identifier
# Base URL format: https://gateway.ai.cloudflare.com/v1/{CF_AIG_ACCOUNT_ID}/{CF_AIG_GATEWAY_NAME}/{GATEWAY_PROVIDER}
CF_AIG_ACCOUNT_ID="your_cloudflare_account_id"
CF_AIG_GATEWAY_NAME="your_ai_gateway_name"

# Gateway provider path: "google-ai-studio" | "openai" | "anthropic"
GATEWAY_PROVIDER="google-ai-studio"

# Gateway model name:
# For Google AI Studio: "gemini-3.8-flash", "gemini-3.1-pro-preview", etc.
# For OpenAI: "gpt-4o", "gpt-4o-mini", etc.
# For Anthropic: "claude-3-7-sonnet", "claude-3-5-haiku", etc.
GATEWAY_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# 4. External Provider API Keys (Stored as Cloudflare Secrets or in .dev.vars)
# NOTE: All requests flow strictly through Cloudflare AI Gateway, never directly.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
