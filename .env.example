# ==============================================================================
# CVMama AI Configuration (Cloudflare Workers AI & AI Gateway via Binding)
# ==============================================================================

# Model identifiers for Cloudflare Workers AI
WORKERS_AI_CHAT_MODEL="@cf/openai/gpt-oss-20b"
WORKERS_AI_PARSER_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# Cloudflare AI Gateway Identifier (connected directly via the AI binding)
# Defaults to "default" for automatic account-level observability, caching, and rate limiting.
CF_AIG_GATEWAY_NAME="default"
